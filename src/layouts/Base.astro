---
import "../styles/tokens.css";
import "../styles/themes.css";
import "../styles/base.css";
import "../styles/content-design.css";
import { previewHeader } from "../../previews/homepage/preview-header.mjs";
import { applyPreviewFooter } from "../../previews/homepage/preview-footer.mjs";
import { designMarkup, designRail } from "../lib/site-design.mjs";
import { config } from "../lib/config";
import { ui } from "../lib/content";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const fullTitle = path === "/" ? `${config.site.name} · ${title}` : `${title} · ${config.site.name}`;
const canonical = new URL(path, config.site.url).href;
const ogImage = config.images.ogDefault?.src ? new URL(config.images.ogDefault.src, config.site.url).href : undefined;
const footer = applyPreviewFooter(`<footer class="sp-footer"><div class="sp-footer-bottom"><span>This site uses no analytics.</span><span>Villow · Local preview</span></div><p class="sp-footer-disclaimer">Villow is not affiliated with, endorsed by, or sponsored by YouTube or Google. YouTube is a trademark of Google LLC.</p></footer>`);
const sharedStyles = ["secondary-preview.css", "study-navigation.css", "preview-header.css", "site-directory.css", "preview-footer.css", "navigation-studies.css", "footer-spidey.css"];
const content = designMarkup(await Astro.slots.render('default'));
---

<html lang={config.site.lang} data-theme={config.theme} class="content-document" data-villow-site>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfaf3" />
    <link rel="canonical" href={canonical} />
    <!-- Villow icons, from the icon kit (master copy in the design repo). Keep this order, and
         keep sizes="32x32" on the .ico, or Chrome picks it over the .svg that adapts to light and dark. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#2A9086" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.site.name} />
    <meta property="og:locale" content={config.site.lang.replace("-", "_")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {sharedStyles.map((file) => <link rel="stylesheet" href={`/_design/${file}`} />)}
  </head>
  <body class:list={["secondary-preview", "content-design", ["/faq", "/app-privacy", "/site-privacy", "/terms"].includes(path) && "reading-content"]}>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Fragment set:html={designMarkup(designRail(path))} />
    <Fragment set:html={designMarkup(previewHeader())} />
    <main id="main" class="content-main" tabindex="-1">
      <Fragment set:html={content} />
    </main>
    <Fragment set:html={designMarkup(footer)} />
    <script is:inline type="module" src="/_design/site-directory.js"></script>
    <script is:inline type="module" src="/_design/footer-spidey.js"></script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
