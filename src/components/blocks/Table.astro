---
import type { BlockOf } from "../../lib/schema";
import { inline, md, slugify } from "../../lib/markdown";
import BlockShell from "../ui/BlockShell.astro";
import BlockHeader from "../ui/BlockHeader.astro";

interface Props {
  block: BlockOf<"table">;
}

const { block } = Astro.props;
const headingId = block.heading ? `${block.id ?? slugify(block.heading)}-title` : undefined;

block.rows.forEach((row, i) => {
  if (row.length !== block.columns.length) {
    throw new Error(`Table "${block.heading ?? block.id}": row ${i + 1} has ${row.length} cells but there are ${block.columns.length} columns.`);
  }
});
---

<BlockShell type="table" id={block.id} background={block.background} width="narrow" labelledBy={headingId}>
  <BlockHeader eyebrow={block.eyebrow} heading={block.heading} intro={block.intro} headingId={headingId} />
  <div class:list={["table", `table--${block.variant}`]}>
    <table>
      <thead>
        <tr>{block.columns.map((column) => <th scope="col" set:html={inline(column)} />)}</tr>
      </thead>
      <tbody>
        {
          block.rows.map((row) => (
            <tr>
              {row.map((cell, i) =>
                i === 0 ? (
                  <th scope="row" data-label={block.columns[i]} set:html={inline(cell)} />
                ) : (
                  <td data-label={block.columns[i]} set:html={inline(cell)} />
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {block.note && <div class="table__note prose" set:html={md(block.note)} />}
</BlockShell>

<style>
  .table table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .table th,
  .table td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--border);
  }
  .table thead th {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom-width: 2px;
  }
  .table tbody th {
    font-weight: 500;
  }
  .table--comparison tbody th {
    color: var(--color-text-muted);
  }
  .table--comparison tbody td {
    font-weight: 500;
  }
  .table--comparison thead th:last-child {
    color: var(--color-accent-text);
  }
  .table__note {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* On phones each row becomes a small card, with the column name above each cell. */
  @media (max-width: 40rem) {
    .table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .table table,
    .table tbody,
    .table tr,
    .table th,
    .table td {
      display: block;
    }
    .table tr {
      padding-block: var(--space-sm);
      border-bottom: var(--border);
    }
    .table th,
    .table td {
      padding: var(--space-2xs) 0;
      border: 0;
    }
    .table tbody :is(th, td)::before {
      content: attr(data-label);
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--weight-strong);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .table--comparison tbody td::before {
      color: var(--color-accent-text);
    }
  }
</style>
